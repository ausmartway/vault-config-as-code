# Vault Enterprise License
# Required for Vault Enterprise features in local development
# Get your license at: https://www.hashicorp.com/products/vault/trial
VAULT_LICENSE=your-vault-license-key-here

# Optional: Timezone for containers (default: Australia/Sydney)
TZ=Australia/Sydney

# Optional: Terraform Cloud/Enterprise Token
# Required if using private Terraform modules from app.terraform.io
TFE_TOKEN=your-tfe-token-here

# Optional: AWS Credentials (if testing AWS auth)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token
